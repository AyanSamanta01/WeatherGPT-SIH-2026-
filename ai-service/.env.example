# WeatherGPT AI/LLM Microservice Configuration (SIH 2026)

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider ("gemini" | "openai" | "anthropic" | "ollama" | "fallback")
# If no keys are provided, the service runs automatically in high-fidelity deterministic fallback mode
AI_PROVIDER=fallback

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI / OpenRouter Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama / Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# LLM Generation Hyperparameters
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# External Weather Gateway & Backend URL
BACKEND_API_URL=http://localhost:5000/api/v1
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
