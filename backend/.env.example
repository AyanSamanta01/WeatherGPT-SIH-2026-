# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL=postgresql://weather_user:weather_password@localhost:5432/weathergpt_db?schema=public

# JWT Authentication
JWT_SECRET=weathergpt_super_secure_jwt_secret_sih_2026_key
JWT_EXPIRES_IN=7d

# Weather Provider Configuration: 'open-meteo' | 'openweather' | 'imd'
WEATHER_PROVIDER=open-meteo

# Optional External API Keys
OPENWEATHER_API_KEY=
IMD_API_KEY=

# AI and GIS Microservice Configuration
AI_SERVICE_URL=http://localhost:8000
GIS_SERVICE_URL=http://localhost:8001

# CORS Configuration (Comma-separated origins or * for open development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80
